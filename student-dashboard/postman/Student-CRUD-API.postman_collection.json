{
  "info": {
    "name": "Student CRUD API",
    "description": "CRUD tests for the Student API. Set the `baseUrl` collection variable to your deployed URL (e.g. https://student-crud-api.onrender.com). Run requests in order, or use the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health check",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
    },
    {
      "name": "1. CREATE student (POST)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.test('Returns created student with id', () => { pm.expect(body.success).to.be.true; pm.expect(body.data.id).to.be.a('string'); });",
        "pm.collectionVariables.set('studentId', body.data.id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha Patil\",\n  \"email\": \"asha.{{$timestamp}}@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 21\n}" },
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "2. READ all students (GET)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "students"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "q", "value": "", "disabled": true }] } }
    },
    {
      "name": "3. READ one student (GET)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Correct id returned', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('studentId')));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
    },
    {
      "name": "4. UPDATE student - full (PUT)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Course updated', () => pm.expect(pm.response.json().data.course).to.eql('Data Science'));"
      ] } }],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha Patil\",\n  \"email\": \"asha.updated.{{$timestamp}}@example.com\",\n  \"course\": \"Data Science\",\n  \"age\": 22\n}" },
        "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] }
      }
    },
    {
      "name": "5. UPDATE student - partial (PATCH)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Age updated, course unchanged', () => { const d = pm.response.json().data; pm.expect(d.age).to.eql(23); pm.expect(d.course).to.eql('Data Science'); });"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"age\": 23\n}" },
        "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] }
      }
    },
    {
      "name": "6. Validation error (POST invalid body)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 400', () => pm.response.to.have.status(400));",
        "pm.test('Errors listed', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"age\": \"abc\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "7. DELETE student (DELETE)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 200', () => pm.response.to.have.status(200));",
        "pm.test('Success message', () => pm.expect(pm.response.json().success).to.be.true);"
      ] } }],
      "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
    },
    {
      "name": "8. READ deleted student (expect 404)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"
      ] } }],
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["api", "students", "{{studentId}}"] } }
    }
  ]
}
